<section class="w-full text-center py-10" aria-labelledby="community-orgs-heading">
	<h2 id="community-orgs-heading" class="block mb-5 text-xl md:text-2xl leading-tight font-semibold">
		Check out these other <span class="text-blue-600">awesome</span> local tech groups &amp; events
	</h2>
	<ul class="w-full flex flex-wrap content-stretch gap-[0.5rem] sm:flex-nowrap">
		<li class="community-org-item">
			<a href="https://www.iowastartupweek.com/" class="community-org-link" target="_blank" rel="noopener noreferrer">
				<img src="/images/org-isw.png" alt="Iowa Startup Week" class="max-h-[3.125rem] aspect-97/50">
				<span class="sr-only">(opens in a new tab)</span>
			</a>
		</li>
		<li class="community-org-item">
			<a href="https://www.techfusedsm.com/" class="community-org-link" target="_blank" rel="noopener noreferrer">
				<img src="/images/org-techfuse.png" alt="Tech Fuse DSM" class="max-h-[3.75rem] aspect-48/60">
				<span class="sr-only">(opens in a new tab)</span>
			</a>
		</li>
		<li class="community-org-item">
			<a href="https://dsmhack.org/" class="community-org-link" target="_blank" rel="noopener noreferrer">
