---
import { Buffer } from "node:buffer";
import { env } from "cloudflare:workers";

interface FeaturedMember {
	name: string;
	title: string;
	company: string;
	photo: string;
	companyLogo?: string;
}

interface AirtableAttachment {
	url: string;
	type?: string;
	thumbnails?: { large?: { url: string } };
}

// Dev-only: astro dev re-runs this frontmatter on every full-page reload,
// which re-fetches Airtable every time (e.g. on every save while tweaking
// styles). Cache on globalThis (survives Vite reloading this module when
// this file itself changes) for the life of the dev server process, so
// reloads reuse the last result instead of hitting Airtable again. Restart
// `npm run dev` to pick up schema changes (new/renamed columns). Has no
// effect on the prerendered production build, which only runs this once
// at build time.
declare global {
	var __featuredMembersDevCache: FeaturedMember[] | undefined;
}

// Airtable attachment URLs are signed and expire a few hours after being
// issued. Since this page is prerendered once at build time (see README),
// baking those URLs straight into the HTML would mean images break shortly
// after every deploy. Instead, fetch each image at build time and inline it
// as a base64 data URI, so the live site never depends on an Airtable URL
// staying valid. (Prerendering runs inside the Cloudflare adapter's workerd
// sandbox, which has no real filesystem, so downloading to a static file
// isn't an option here — a data URI needs only fetch(), which the sandbox
// already supports.) Uses Airtable's "large" thumbnail rather than the
// original upload to keep raster images small — plenty for a 48px
// avatar/logo. SVGs are the exception: Airtable's thumbnails rasterize them
// to PNG, so we skip the thumbnail and fetch the original to keep them
// vector.
// Dev keeps using live Airtable URLs directly — sessions are short enough
// that expiry isn't a concern, and it avoids re-fetching on every reload.
async function toDataUri(attachment: AirtableAttachment): Promise<string> {
	const isVector = attachment.type === "image/svg+xml";
	const sourceUrl = isVector ? attachment.url : (attachment.thumbnails?.large?.url ?? attachment.url);

	try {
		const response = await fetch(sourceUrl);
		if (!response.ok) throw new Error(`HTTP ${response.status}`);

		const buffer = Buffer.from(await response.arrayBuffer());
		// Trust the fetched response's own Content-Type, not attachment.type: Airtable
		// rasterizes thumbnails (e.g. an SVG's "large" thumbnail comes back as a PNG),
		// so attachment.type (the *original* file's mime type) can disagree with the
		// bytes we actually fetched, producing an invalid data URI (e.g. PNG bytes
		// mislabeled image/svg+xml, which browsers refuse to render).
		const mimeType = response.headers.get("content-type") ?? attachment.type ?? "image/jpeg";
		return `data:${mimeType};base64,${buffer.toString("base64")}`;
	} catch (error) {
		console.error(`Failed to inline image ${sourceUrl}, falling back to Airtable URL:`, error);
		return attachment.url;
	}
}

async function fetchCompanyLogos(
	baseId: string,
	token: string,
	tableId: string,
): Promise<Map<string, string>> {
	const params = new URLSearchParams({ "fields[]": "Logo" });

	const response = await fetch(
		`https://api.airtable.com/v0/${baseId}/${tableId}?${params}`,
		{ headers: { Authorization: `Bearer ${token}` } },
	);

	if (!response.ok) {
		console.error("Airtable Error (Companies):", await response.text());
		return new Map();
	}

	const { records } = (await response.json()) as {
		records: { id: string; fields: { Logo?: AirtableAttachment[] } }[];
	};

	const withLogos = records.filter((record) => record.fields.Logo?.[0]);

	const entries = await Promise.all(
		withLogos.map(async (record) => {
			const attachment = record.fields.Logo![0];
			const src = import.meta.env.PROD ? await toDataUri(attachment) : attachment.url;
			return [record.id, src] as const;
		}),
	);

	return new Map(entries);
}

async function getFeaturedMembers(): Promise<FeaturedMember[]> {
	if (import.meta.env.DEV && globalThis.__featuredMembersDevCache) {
		return globalThis.__featuredMembersDevCache;
	}

	const {
		AIRTABLE_ACCESS_TOKEN,
		AIRTABLE_BASE_ID,
		AIRTABLE_MEMBERSHIP_TABLE_ID,
		AIRTABLE_COMPANIES_TABLE_ID,
	} = env;

	const params = new URLSearchParams({
		filterByFormula: "{Featured Member}=1",
		"sort[0][field]": "Last Name",
		"sort[0][direction]": "asc",
	});
	for (const field of ["Full Name", "Title", "Name (from Company)", "Company", "Photo"]) {
		params.append("fields[]", field);
	}

	const airtableUrl = `https://api.airtable.com/v0/${AIRTABLE_BASE_ID}/${AIRTABLE_MEMBERSHIP_TABLE_ID}?${params}`;

	try {
		const [response, companyLogos] = await Promise.all([
			fetch(airtableUrl, { headers: { Authorization: `Bearer ${AIRTABLE_ACCESS_TOKEN}` } }),
			fetchCompanyLogos(AIRTABLE_BASE_ID, AIRTABLE_ACCESS_TOKEN, AIRTABLE_COMPANIES_TABLE_ID),
		]);

		if (!response.ok) {
			console.error("Airtable Error:", await response.text());
			return [];
		}

		const { records } = (await response.json()) as {
			records: {
				id: string;
				fields: {
					"Full Name"?: string;
					Title?: string;
					"Name (from Company)"?: string[];
					Company?: string[];
					Photo?: AirtableAttachment[];
				};
			}[];
		};

		const members = await Promise.all(
			records
				.filter((record) => record.fields["Full Name"] && record.fields.Photo?.[0])
				.map(async (record) => {
					const companyId = record.fields.Company?.[0];
					const photoAttachment = record.fields.Photo![0];
					const photo = import.meta.env.PROD
						? await toDataUri(photoAttachment)
						: photoAttachment.url;

					return {
						name: record.fields["Full Name"]!,
						title: record.fields.Title ?? "",
						company: record.fields["Name (from Company)"]?.[0] ?? "",
						photo,
						companyLogo: companyId ? companyLogos.get(companyId) : undefined,
					};
				}),
		);

		if (import.meta.env.DEV) {
			globalThis.__featuredMembersDevCache = members;
		}

		return members;
	} catch (error) {
		console.error("Featured members fetch error:", error);
		return [];
	}
}

const featuredMembers = await getFeaturedMembers();
---

{featuredMembers.length > 0 && (
	<section class="w-full text-center py-10" aria-labelledby="featured-members-heading">
		<h2 id="featured-members-heading" class="block mb-5 text-2xl md:text-4xl leading-tight font-semibold">
			Meet a few <span class="text-blue-600">members</span> in our community
		</h2>

		<ul class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
			{featuredMembers.map((member) => (
				<li class="member-card">
					<div class="flex w-full items-center gap-2">
						<img
							src={member.photo}
							alt={member.name}
							width="48"
							height="48"
							class="size-12 shrink-0 rounded-full border border-blue-300 object-cover"
						/>
						<p class="text-xl font-semibold text-slate-900">{member.name}</p>
					</div>
					<div class="mt-2 flex w-full items-end gap-2">
						<p class="text-sm leading-snug text-slate-600">
							<span class="block font-semibold">{member.title}</span>
							<span class="block">{member.company}</span>
						</p>
						{member.companyLogo && (
							<img src={member.companyLogo} alt="" class="member-card-logo" />
						)}
					</div>
				</li>
			))}
		</ul>
	</section>
)}
