---
import { env } from "cloudflare:workers";

interface FeaturedMember {
	name: string;
	title: string;
	company: string;
	photo: string;
	companyLogo?: string;
}

async function fetchCompanyLogos(
	baseId: string,
	token: string,
	tableId: string,
): Promise<Map<string, string>> {
	const params = new URLSearchParams({ "fields[]": "Logo" });

	const response = await fetch(
		`https://api.airtable.com/v0/${baseId}/${tableId}?${params}`,
		{ headers: { Authorization: `Bearer ${token}` } },
	);

	if (!response.ok) {
		console.error("Airtable Error (Companies):", await response.text());
		return new Map();
	}

	const { records } = (await response.json()) as {
		records: { id: string; fields: { Logo?: { url: string }[] } }[];
	};

	return new Map(
		records
			.filter((record) => record.fields.Logo?.[0]?.url)
			.map((record) => [record.id, record.fields.Logo![0].url]),
	);
}

async function getFeaturedMembers(): Promise<FeaturedMember[]> {
	const {
		AIRTABLE_ACCESS_TOKEN,
		AIRTABLE_BASE_ID,
		AIRTABLE_MEMBERSHIP_TABLE_ID,
		AIRTABLE_COMPANIES_TABLE_ID,
	} = env;

	const params = new URLSearchParams({
		filterByFormula: "{Featured Member}=1",
		"sort[0][field]": "Last Name",
		"sort[0][direction]": "asc",
	});
	for (const field of ["Full Name", "Title", "Name (from Company)", "Company", "Photo"]) {
		params.append("fields[]", field);
	}

	const airtableUrl = `https://api.airtable.com/v0/${AIRTABLE_BASE_ID}/${AIRTABLE_MEMBERSHIP_TABLE_ID}?${params}`;

	try {
		const [response, companyLogos] = await Promise.all([
			fetch(airtableUrl, { headers: { Authorization: `Bearer ${AIRTABLE_ACCESS_TOKEN}` } }),
			fetchCompanyLogos(AIRTABLE_BASE_ID, AIRTABLE_ACCESS_TOKEN, AIRTABLE_COMPANIES_TABLE_ID),
		]);

		if (!response.ok) {
			console.error("Airtable Error:", await response.text());
			return [];
		}

		const { records } = (await response.json()) as {
			records: {
				id: string;
				fields: {
					"Full Name"?: string;
					Title?: string;
					"Name (from Company)"?: string[];
					Company?: string[];
					Photo?: { url: string }[];
				};
			}[];
		};

		return records
			.filter((record) => record.fields["Full Name"] && record.fields.Photo?.[0]?.url)
			.map((record) => {
				const companyId = record.fields.Company?.[0];
				return {
					name: record.fields["Full Name"]!,
					title: record.fields.Title ?? "",
					company: record.fields["Name (from Company)"]?.[0] ?? "",
					photo: record.fields.Photo![0].url,
					companyLogo: companyId ? companyLogos.get(companyId) : undefined,
				};
			});
	} catch (error) {
		console.error("Featured members fetch error:", error);
		return [];
	}
}

const featuredMembers = await getFeaturedMembers();
---

{featuredMembers.length > 0 && (
	<section class="w-full text-center py-10" aria-labelledby="featured-members-heading">
		<h2 id="featured-members-heading" class="block mb-5 text-2xl md:text-4xl leading-tight font-semibold">
			Meet a few <span class="text-blue-600">members</span> in our community
		</h2>

		<ul class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
			{featuredMembers.map((member) => (
				<li class="member-card">
					<div class="flex w-full items-center gap-2">
						<img
							src={member.photo}
							alt={member.name}
							width="48"
							height="48"
							class="size-12 shrink-0 rounded-full border border-blue-300 object-cover"
						/>
						<p class="text-xl font-semibold text-slate-900">{member.name}</p>
					</div>
					<div class="mt-2 flex w-full items-end gap-2">
						<p class="text-sm leading-snug text-slate-600">
							<span class="block font-semibold">{member.title}</span>
							<span class="block">{member.company}</span>
						</p>
						{member.companyLogo && (
							<img src={member.companyLogo} alt="" class="member-card-logo" />
						)}
					</div>
				</li>
			))}
		</ul>
	</section>
)}
