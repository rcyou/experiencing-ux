---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import Hero from "../components/Hero.astro";
import FeaturedMembers from "../components/FeaturedMembers.astro";
import FeaturedCompanies from "../components/FeaturedCompanies.astro";
import CommunityOrgs from "../components/CommunityOrgs.astro";
import SignupForm from "../components/SignupForm.astro";
import LinkedInCTA from "../components/LinkedInCTA.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout>
	<main class="max-w-4xl mx-auto flex w-full flex-col items-center px-4 pt-6 pb-4">
		<div class="flex flex-col items-center gap-8">
			<Logo />
			<Hero />
			<FeaturedMembers />
			<FeaturedCompanies />
			<CommunityOrgs />
			<SignupForm />
			<LinkedInCTA />
			<Footer />
		</div>
	</main>
</BaseLayout>
