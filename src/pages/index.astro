---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Logo from "../components/Logo.astro";
import Hero from "../components/Hero.astro";
import FeaturedMembers from "../components/FeaturedMembers.astro";
import FeaturedCompanies from "../components/FeaturedCompanies.astro";
import CommunityOrgs from "../components/CommunityOrgs.astro";
import SignupForm from "../components/SignupForm.astro";
import LinkedInCTA from "../components/LinkedInCTA.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout>
	<Nav />
	<main class="max-w-4xl mx-auto flex w-full flex-col items-center px-4 pt-6 pb-4">
		<div class="flex flex-col items-center gap-8">
			<Logo />
			<Hero />
			<FeaturedMembers />
			<FeaturedCompanies />
			<CommunityOrgs />
			<section class="max-w-xl w-full rounded-md bg-white/40 border border-slate-200 backdrop-blur-md p-6">
				<script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="2c1e6974-00b3-496a-819f-1b56e89bb6d1"></script>
			</section>
			<LinkedInCTA />
			<Footer />
		</div>
	</main>
</BaseLayout>
